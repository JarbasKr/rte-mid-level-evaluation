{
  "info": {
    "name": "RTE Gestão de Colaboradores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "unidadeId", "value": "" },
    { "key": "colaboradorCodigo", "value": "COL001" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  if (body.user && body.user.id) { pm.collectionVariables.set('userId', body.user.id); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Buscar por codigo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/usuarios/ADM001"
          }
        },
        {
          "name": "Criar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"USR999\",\n  \"login\": \"usuario.teste\",\n  \"senha\": \"Senha@123\",\n  \"status\": \"Ativo\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Atualizar",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Ativo\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios/USR999"
          }
        }
      ]
    },
    {
      "name": "Unidades",
      "item": [
        {
          "name": "Listar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const items = pm.response.json();",
                  "  const ativa = items.find(x => x.codigo === 'UND001');",
                  "  if (ativa) { pm.collectionVariables.set('unidadeId', ativa.id); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/unidades"
          }
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/unidades/{{unidadeId}}"
          }
        },
        {
          "name": "Criar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"UND999\",\n  \"nome\": \"Unidade Teste\",\n  \"status\": \"Ativo\"\n}"
            },
            "url": "{{baseUrl}}/api/unidades"
          }
        },
        {
          "name": "Atualizar",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Unidade Teste Atualizada\",\n  \"status\": \"Ativo\"\n}"
            },
            "url": "{{baseUrl}}/api/unidades/{{unidadeId}}"
          }
        }
      ]
    },
    {
      "name": "Colaboradores",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/colaboradores"
          }
        },
        {
          "name": "Buscar por codigo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/colaboradores/{{colaboradorCodigo}}"
          }
        },
        {
          "name": "Criar",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"COL999\",\n  \"nome\": \"Colaborador Teste\",\n  \"unidadeId\": \"{{unidadeId}}\",\n  \"usuarioId\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/colaboradores"
          }
        },
        {
          "name": "Atualizar",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Colaborador Atualizado\",\n  \"unidadeId\": \"{{unidadeId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/colaboradores/{{colaboradorCodigo}}"
          }
        },
        {
          "name": "Excluir",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/colaboradores/COL999"
          }
        }
      ]
    }
  ]
}
